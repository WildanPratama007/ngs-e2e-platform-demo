/*
 * NGS E2E Platform - Nextflow Configuration
 */

// Parameter default pipeline
params {
    reads        = null
    ref_genome   = "${projectDir}/ref_genome/chr22.fa"
    outdir       = "${projectDir}/results"
    trimmer_opts = "SLIDINGWINDOW:4:20 MINLEN:25 LEADING:3 TRAILING:3"
    fastqc_path  = "/mnt/c/Users/Mahasiswa/Fastt/FastQC/fastqc"
    ploidy       = "GRCh38"
    bin_dir      = "/home/mahasiswa/miniconda3/envs/ngs_platform/bin"
    samtools_bin = "/usr/bin/samtools"
    bcftools_bin = "/usr/bin/bcftools"
}

// Profil eksekusi
profiles {

    standard {
        process.executor = 'local'
        conda.enabled    = true

        process {
            withName: 'FASTQC'         { conda = 'bioconda::fastqc' }
            withName: 'TRIMMOMATIC_SE' { conda = 'bioconda::trimmomatic' }
            withName: 'BWA_ALIGN'      { conda = 'bioconda::bwa bioconda::samtools' }
            withName: 'VARIANT_CALLING'{ conda = 'bioconda::bcftools' }
        }
    }

    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {
            withName: 'FASTQC'         { container = 'biocontainers/fastqc:v0.11.9_cv8' }
            withName: 'TRIMMOMATIC_SE' { container = 'staphb/trimmomatic:0.39' }
            withName: 'BWA_ALIGN'      { container = 'biocontainers/bwa:v0.7.17_cv1' }
            withName: 'VARIANT_CALLING'{ container = 'biocontainers/bcftools:v1.9-1-deb_cv1' }
        }
    }

    conda_env {
        process.executor  = 'local'
        conda.enabled     = true
        process.conda     = '/home/mahasiswa/miniconda3/envs/ngs_platform'
        process.beforeScript = 'export PATH=/home/mahasiswa/miniconda3/envs/ngs_platform/bin:$PATH'
    }
}

// Konfigurasi laporan eksekusi
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
